<UserControl x:Class="Tether.DesktopUI.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:Tether.DesktopUI.ViewModels">

    <StackPanel>
        <TextBlock Text="Authentication Manager" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
        <TextBlock Text="Configure local security fallback configurations below." FontSize="14" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,20"/>
        <TextBlock Text="{Binding UserTypeDisplay}" FontSize="12" Foreground="{DynamicResource MaterialDesignPrimaryLight}" Margin="0,0,0,15"/>

        <!-- Local Account Password -->
        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="🔐 Local Account Password" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,10"/>
                <TextBlock Text="Enter your Windows login password. This will be stored securely (salted hash + DPAPI)." FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <PasswordBox x:Name="TxtPassword" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,15" 
                             materialDesign:HintAssist.Hint="Password"/>
                <Button Content="Commit Secret to Secure Registry" Command="{Binding SavePasswordCommand}" CommandParameter="{Binding ElementName=TxtPassword}"
                        Height="42" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Phone Public Key -->
        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="📱 Phone Public Key" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,10"/>
                <TextBlock Text="Paste your Android phone's public key (Base64) here." FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBox x:Name="TxtPhoneKey" Text="{Binding PhonePublicKey, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15" 
                         materialDesign:HintAssist.Hint="Public Key"/>
                <Button Content="Save Phone Key" Command="{Binding SavePhoneKeyCommand}"
                        Height="42" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Help Section -->
        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="ℹ️ How to get the phone's public key" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,10"/>
                <TextBlock Text="1. Run the Tether app on your Android phone" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                <TextBlock Text="2. Check Logcat output (use Logcat Reader app or Android Studio)" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                <TextBlock Text="3. Look for lines between the ====== markers" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                <TextBlock Text="4. Copy the entire Base64 string starting with 'MIIBIjAN...'" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                <TextBlock Text="5. Paste it above and click 'Save Phone Key'" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
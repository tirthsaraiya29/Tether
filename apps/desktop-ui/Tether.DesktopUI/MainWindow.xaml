<Window x:Class="Tether.DesktopUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tether Desktop" Height="350" Width="500">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Tether Trust Status" FontSize="20" Margin="0,0,0,10"/>
            <TextBox x:Name="StatusTextBox" Height="100" IsReadOnly="True" TextWrapping="Wrap"/>
            <Button x:Name="SimulatePhoneConnectedBtn" Content="Simulate Phone Connected" Margin="0,10,0,5" Click="SimulatePhoneConnected_Click"/>
            <Button x:Name="SimulatePhoneDisconnectedBtn" Content="Simulate Phone Disconnected" Click="SimulatePhoneDisconnected_Click"/>
            <Button x:Name="PanicButton" Content="Trigger Panic (Lock Screen)" Margin="0,10,0,5" Click="PanicButton_Click" Background="Red" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
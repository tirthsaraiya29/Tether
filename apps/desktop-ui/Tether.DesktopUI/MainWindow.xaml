<Window x:Class="Tether.DesktopUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TETHER // COMMAND INTERFACE" Height="620" Width="550" 
        Background="#0A0E17" WindowStartupLocation="CenterScreen"
        BorderBrush="#00F0FF" BorderThickness="1" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="LiquidCard" TargetType="Border">
            <Setter Property="Background" Value="#111A2E"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#0DFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="TETHER CORE" FontSize="26" FontWeight="Black" Foreground="#FFFFFF"/>
            <TextBlock x:Name="TxtUserType" Text="IDENTIFYING HOST CONTEXT..." FontSize="11" Foreground="#00F0FF" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource LiquidCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MESH NETWORKING" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtStatus" Text="WAITING FOR HOST PIPELINE CONNECTION..." FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtRssi" Text="RSSI: -- dBm" FontSize="12" Foreground="#8A99AD" Margin="0,4,0,0"/>
                </StackPanel>
                <Ellipse x:Name="IndicatorNode" Grid.Column="1" Width="14" Height="14" Fill="#FF0055" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource LiquidCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="CRYPTOGRAPHIC VAULT CONFIGURATION" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,4"/>
                    <TextBlock Text="Synchronize your native Windows credentials into the local machine vault. Credentials are protected via hardware-scoped DPAPI." 
                               FontSize="11" Foreground="#8A99AD" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="TARGET ACCOUNT PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtPassword" Height="36" Background="#060A12" Foreground="#FFFFFF" BorderBrush="#22FFFFFF" 
                                 VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,20"/>

                    <Button Content="COMMIT SECRET TO SECURITY REGISTRY" Height="42" Background="#00F0FF" Foreground="#0A0E17" 
                            FontWeight="Bold" Click="BtnCommitVault_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <UniformGrid Grid.Row="3" Columns="2" Rows="1">
            <Button Content="MANUAL UNLOCK" Height="38" Margin="0,0,8,0" Background="#122E1A" Foreground="#00FF66" BorderBrush="#00FF66" BorderThickness="0.5" FontWeight="Bold" Click="BtnUnlockOverride_Click"/>
            <Button Content="FORCE LOCKDOWN" Height="38" Margin="8,0,0,0" Background="#2E111A" Foreground="#00F0FF" BorderBrush="#00F0FF" BorderThickness="0.5" FontWeight="Bold" Click="BtnLockdownOverride_Click"/>
        </UniformGrid>
    </Grid>
</Window>
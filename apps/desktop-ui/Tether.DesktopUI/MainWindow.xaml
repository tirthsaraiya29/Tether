<Window x:Class="Tether.DesktopUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tether — Security &amp; Telemetry Workstation"
        Height="820" Width="1160"
        MinHeight="720" MinWidth="1020"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="MainWindow_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource GlassSpecularBorderBrush}"
            BorderThickness="1">
        <Grid x:Name="LayoutRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- TOP FLUSH TITLEBAR (ROW 0)                                    -->
            <!-- ============================================================= -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Background="{StaticResource RailBackgroundBrush}"
                    BorderBrush="{StaticResource SubtleDividerBrush}"
                    BorderThickness="0,0,1,1"
                    Padding="20,0,16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="6"
                            Background="{StaticResource AccentPillBackgroundBrush}"
                            BorderBrush="{StaticResource AccentPillBorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="13"
                                   Foreground="{StaticResource SystemAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TETHER"
                                   FontFamily="{StaticResource FluentDisplayFontFamily}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource BadgePillBorderStyle}"
                            Padding="6,2">
                        <TextBlock Text="IPC v2"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextAccentBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Header: Drag Area & Window Buttons -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="{StaticResource TitleBarBackgroundBrush}"
                    BorderBrush="{StaticResource SubtleDividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="24,0,0,0"
                                IsHitTestVisible="False">
                        <TextBlock Text="WORKSTATION"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  /  "
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="TELEMETRY CONTROL PLANE"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource TitleBarButton}"
                                Content="&#xE921;"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="10"
                                Height="44"
                                Width="46"
                                Margin="0"
                                Click="BtnMinimize_Click"/>
                        <Button x:Name="BtnMaximize"
                                Style="{StaticResource TitleBarButton}"
                                Content="&#xE922;"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="10"
                                Height="44"
                                Width="46"
                                Margin="0"
                                Click="BtnMaximize_Click"/>
                        <Button x:Name="BtnClose"
                                Style="{StaticResource CloseTitleBarButton}"
                                Content="&#xE8BB;"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="10"
                                Height="44"
                                Width="48"
                                Margin="0"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- LEFT NAVIGATION RAIL (ROW 1)                                  -->
            <!-- ============================================================= -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="{StaticResource RailBackgroundBrush}"
                    BorderBrush="{StaticResource SubtleDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="WORKSPACE NODES"
                               Style="{StaticResource SectionEyebrowTextStyle}"
                               Margin="20,18,0,8"/>

                    <ListBox x:Name="NavRailList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource NavigationItemStyle}"
                             SelectionChanged="NavRailList_SelectionChanged">
                        <ListBoxItem IsSelected="True" Tag="All">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEEA3;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="15"
                                           Width="22"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Telemetry Overview"
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Hardware">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE95A;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="15"
                                           Width="22"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Hardware Controls"
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Vault">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="15"
                                           Width="22"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="DPAPI Vault"
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Security Principal Card -->
                    <Border Grid.Row="2"
                            Margin="12,0,12,12"
                            Padding="14,12"
                            CornerRadius="10"
                            Background="{StaticResource GlassSurfaceSubtleBrush}"
                            BorderBrush="{StaticResource GlassSpecularBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="28" Height="28"
                                    CornerRadius="14"
                                    Background="#18FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="13"
                                           Foreground="{StaticResource SystemAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SECURITY PRINCIPAL"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtUserType"
                                           Text="DOMAIN UNRESOLVED"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- MAIN CONTENT CANVAS (ROW 1)                                   -->
            <!-- ============================================================= -->
            <Grid Grid.Row="1"
                  Grid.Column="1"
                  Margin="24,18,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="0.92*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <ScrollViewer x:Name="LeftScrollViewer"
                              Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <StackPanel>

                        <!-- File Transfers Card -->
                        <Border x:Name="CardFileTransfer" Style="{StaticResource GlassPanel}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="QUIC FILE SHARING // UDP:37125 • SHA-512"
                                                   Style="{StaticResource SectionEyebrowTextStyle}"/>
                                        <TextBlock Text="Active &amp; Recent Transfers"
                                                   Style="{StaticResource CardTitleTextStyle}"/>
                                    </StackPanel>

                                    <Button x:Name="BtnOpenDownloadsFolder"
                                            Grid.Column="1"
                                            Height="32"
                                            Padding="12,0"
                                            Style="{StaticResource {x:Type Button}}"
                                            Click="BtnOpenDownloadsFolder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;"
                                                       FontFamily="{StaticResource IconFontFamily}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="Open Downloads"
                                                       FontFamily="{StaticResource FluentFontFamily}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="0,14,0,0"
                                        Padding="14,12"
                                        CornerRadius="8"
                                        Background="#1A000000"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtTransferFileName"
                                                       Text="No active file transfers"
                                                       FontFamily="{StaticResource FluentFontFamily}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtTransferSpeed"
                                                       Grid.Column="1"
                                                       Text="0.0 MB/s"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>

                                        <ProgressBar x:Name="TransferProgressBar"
                                                     Height="6"
                                                     Margin="0,10,0,8"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="0"
                                                     Foreground="{StaticResource SystemAccentBrush}"
                                                     Background="#33FFFFFF"
                                                     BorderThickness="0"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtTransferMeta"
                                                       Text="Receiver ready • ALPN tether-quic-v1"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Button x:Name="BtnCancelActiveTransfer"
                                                    Grid.Column="1"
                                                    Height="24"
                                                    Padding="8,0"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource DestructiveButton}"
                                                    Click="BtnCancelActiveTransfer_Click">
                                                <TextBlock Text="Cancel" FontSize="10" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Security Pipeline Card -->
                        <Border x:Name="CardPipeline" Style="{StaticResource GlassPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SIGNAL ENFORCEMENT // NAMED PIPE BUS"
                                                   Style="{StaticResource SectionEyebrowTextStyle}"/>
                                        <TextBlock Text="Core Security Network Pipeline"
                                                   Style="{StaticResource CardTitleTextStyle}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="#14FFFFFF"
                                            BorderBrush="{StaticResource GlassSpecularBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="10,5"
                                            VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                                <Ellipse x:Name="IndicatorHalo"
                                                         Width="16" Height="16"
                                                         Fill="{StaticResource CriticalHaloBrush}"/>
                                                <Ellipse x:Name="IndicatorNode"
                                                         Width="8" Height="8"
                                                         Fill="{StaticResource StatusCriticalBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="NODE LINK"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="0,16,0,0"
                                        Padding="14,12"
                                        CornerRadius="8"
                                        Background="#1A000000"
                                        BorderBrush="{StaticResource SubtleDividerBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="STATE VECTOR"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtStatus"
                                                       Text="WAITING FOR SERVICE PIPELINE..."
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Style="{StaticResource BadgePillBorderStyle}">
                                            <TextBlock x:Name="TxtRssi"
                                                       Text="RSSI NODE: -- dBm"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextAccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Hardware Layer Card -->
                        <Border x:Name="CardHardware" Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <TextBlock Text="COREAUDIO COM &amp; WIN32 BACKENDS"
                                           Style="{StaticResource SectionEyebrowTextStyle}"/>
                                <TextBlock Text="Hardware Device Layer Integrations"
                                           Style="{StaticResource CardTitleTextStyle}"
                                           Margin="0,0,0,18"/>

                                <!-- System Master Volume -->
                                <Border Padding="14,12"
                                        CornerRadius="8"
                                        Background="#16000000"
                                        BorderBrush="{StaticResource SubtleDividerBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE767;"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="14"
                                                           Foreground="{StaticResource SystemAccentBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="System Master Volume"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Border Style="{StaticResource BadgePillBorderStyle}"
                                                    HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtVolumeValue"
                                                           Text="0%"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider x:Name="SliderVolume"
                                                Minimum="0"
                                                Maximum="100"
                                                ValueChanged="SliderVolume_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Display Matrix Luminescence -->
                                <Border Padding="14,12"
                                        CornerRadius="8"
                                        Background="#16000000"
                                        BorderBrush="{StaticResource SubtleDividerBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE706;"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="14"
                                                           Foreground="{StaticResource SystemAccentBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="Display Matrix Luminescence"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Border Style="{StaticResource BadgePillBorderStyle}"
                                                    HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtBrightnessValue"
                                                           Text="0%"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider x:Name="SliderBrightness"
                                                Minimum="0"
                                                Maximum="100"
                                                ValueChanged="SliderBrightness_ValueChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- DPAPI Vault Card -->
                        <Border x:Name="CardVault" Style="{StaticResource GlassPanel}" Margin="0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="CRYPT32 // DPAPI ENTROPY SEAL"
                                                   Style="{StaticResource SectionEyebrowTextStyle}"/>
                                        <TextBlock Text="Local Vault Cryptographic Subsystem"
                                                   Style="{StaticResource CardTitleTextStyle}"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource BadgePillBorderStyle}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="HKLM // DACL v2"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextAccentBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Validate domain credentials via LogonUser and seal secret payload into HKLM CredentialProvider registry storage."
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"
                                           TextWrapping="Wrap"/>

                                <PasswordBox x:Name="TxtPassword"
                                             Margin="0,0,0,14"/>

                                <Button x:Name="BtnCommitVault"
                                        Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Stretch"
                                        Click="BtnCommitVault_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8D7;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Commit Secret To Vault"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT COLUMN -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource GlassPanel}"
                            Padding="20"
                            Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="REALTIME IPC BUS MONITOR"
                                               Style="{StaticResource SectionEyebrowTextStyle}"/>
                                    <TextBlock Text="System Diagnostic Event Stream"
                                               Style="{StaticResource CardTitleTextStyle}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button x:Name="BtnCopyLogs"
                                            Padding="8,4"
                                            Margin="0,0,6,0"
                                            ToolTip="Copy Event Stream"
                                            Click="BtnCopyLogs_Click">
                                        <TextBlock Text="&#xE8C8;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="11"/>
                                    </Button>
                                    <Button x:Name="BtnClearLogs"
                                            Padding="8,4"
                                            Margin="0,0,8,0"
                                            ToolTip="Clear Event Stream"
                                            Click="BtnClearLogs_Click">
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="11"/>
                                    </Button>
                                    <Border Background="#14FFFFFF"
                                            BorderBrush="{StaticResource SubtleDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6"
                                                     Fill="{StaticResource StatusHealthyBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>
                                            <TextBlock Text="RING // 250"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- UI-Virtualized Ring-Buffer Terminal -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource TerminalBackgroundBrush}"
                                    BorderBrush="{StaticResource TerminalBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4">
                                <ListBox x:Name="TerminalList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,3"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11.5"
                                                       Foreground="#E2E8F0"
                                                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Action Buttons: Side-by-Side or Stacked -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnRestartService"
                                Grid.Column="0"
                                Height="44"
                                Style="{StaticResource AccentButton}"
                                Click="BtnRestartService_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE72C;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Restart Service"
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnLockdownOverride"
                                Grid.Column="2"
                                Height="44"
                                Style="{StaticResource DestructiveButton}"
                                Click="BtnLockdownOverride_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="System Lockdown"
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
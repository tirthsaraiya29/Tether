<Window x:Class="Tether.DesktopUI.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:updates="clr-namespace:Tether.DesktopUI.Updates"

        Title="Tether"
        Icon="assets/tether-32.png"

        Height="840" Width="1220"

        MinHeight="720" MinWidth="1040"

        WindowStyle="None"

        ResizeMode="CanResize"

        Background="{StaticResource WindowBackgroundBrush}"

        WindowStartupLocation="CenterScreen"

        UseLayoutRounding="True"

        SnapsToDevicePixels="True"

        TextOptions.TextFormattingMode="Display"

        TextOptions.TextRenderingMode="ClearType"

        PreviewKeyDown="MainWindow_PreviewKeyDown"

        Loaded="MainWindow_Loaded">



    <WindowChrome.WindowChrome>

        <WindowChrome CaptionHeight="46"

                      ResizeBorderThickness="6"

                      GlassFrameThickness="0"

                      CornerRadius="0"

                      UseAeroCaptionButtons="False"/>

    </WindowChrome.WindowChrome>



    <Border BorderBrush="{StaticResource GlassSpecularBorderBrush}"

            BorderThickness="1">

        <Grid x:Name="LayoutRoot">

            <Grid.RowDefinitions>

                <RowDefinition Height="46"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>



            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>



            <!-- ============================================================= -->

            <!-- TOP TITLEBAR (ROW 0)                                          -->

            <!-- ============================================================= -->

            <Border Grid.Row="0"

                    Grid.Column="0"

                    Background="{StaticResource RailBackgroundBrush}"

                    BorderBrush="{StaticResource SubtleDividerBrush}"

                    BorderThickness="0,0,1,1"

                    Padding="18,0,14,0">

                <Grid VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>



                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="6"
                            Background="{StaticResource AccentPillBackgroundBrush}"
                            BorderBrush="{StaticResource AccentPillBorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Image Source="assets/tether-32.png"
                               Width="18" Height="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>



                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">

                        <TextBlock Text="TETHER"

                                   FontFamily="{StaticResource FluentDisplayFontFamily}"

                                   FontSize="12.5"

                                   FontWeight="Bold"

                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock Text="SMART UNLOCK"

                                   FontFamily="{StaticResource MonoFontFamily}"

                                   FontSize="8.5"

                                   Foreground="{StaticResource TextMutedBrush}"/>

                    </StackPanel>



                </Grid>

            </Border>



            <!-- Right Titlebar: Status Strip & Window Controls -->

            <Border Grid.Row="0"

                    Grid.Column="1"

                    Background="{StaticResource TitleBarBackgroundBrush}"

                    BorderBrush="{StaticResource SubtleDividerBrush}"

                    BorderThickness="0,0,0,1">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>



                    <!-- Left Breadcrumb & Connection Badges -->

                    <StackPanel Grid.Column="0"

                                Orientation="Horizontal"

                                VerticalAlignment="Center"

                                Margin="22,0,0,0"

                                IsHitTestVisible="False">

                        <TextBlock x:Name="TxtWorkspaceTitle"

                                   Text="Dashboard"

                                   FontFamily="{StaticResource FluentDisplayFontFamily}"

                                   FontSize="12.5"

                                   FontWeight="SemiBold"

                                   Foreground="{StaticResource TextPrimaryBrush}"

                                   VerticalAlignment="Center"/>

                    </StackPanel>



                    <!-- Live Header Connection Pill -->

                    <Border Grid.Column="1"

                            Background="#0EFFFFFF"

                            BorderBrush="{StaticResource SubtleDividerBrush}"

                            BorderThickness="1"

                            CornerRadius="6"

                            Padding="10,4"

                            Margin="0,0,14,0"

                            VerticalAlignment="Center"

                            IsHitTestVisible="False">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Ellipse x:Name="HeaderIndicatorDot"

                                     Width="7" Height="7"

                                     Fill="{StaticResource StatusCriticalBrush}"

                                     VerticalAlignment="Center"

                                     Margin="0,0,7,0"/>

                            <TextBlock x:Name="TxtHeaderNodeBadge"

                                       Text="DISCONNECTED"

                                       FontFamily="{StaticResource MonoFontFamily}"

                                       FontSize="10"

                                       FontWeight="SemiBold"

                                       Foreground="{StaticResource TextSecondaryBrush}"

                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>



                    <!-- Caption Buttons -->

                    <StackPanel Grid.Column="2"

                                Orientation="Horizontal"

                                HorizontalAlignment="Right"

                                VerticalAlignment="Stretch"

                                WindowChrome.IsHitTestVisibleInChrome="True">

                        <Button x:Name="BtnMinimize"

                                Style="{StaticResource TitleBarButton}"

                                Content="&#xE921;"

                                FontFamily="{StaticResource IconFontFamily}"

                                FontSize="10"

                                Click="BtnMinimize_Click"/>

                        <Button x:Name="BtnMaximize"

                                Style="{StaticResource TitleBarButton}"

                                Content="&#xE922;"

                                FontFamily="{StaticResource IconFontFamily}"

                                FontSize="10"

                                Click="BtnMaximize_Click"/>

                        <Button x:Name="BtnClose"

                                Style="{StaticResource CloseTitleBarButton}"

                                Content="&#xE8BB;"

                                FontFamily="{StaticResource IconFontFamily}"

                                FontSize="10"

                                Width="48"

                                Click="BtnClose_Click"/>

                    </StackPanel>

                </Grid>

            </Border>



            <!-- ============================================================= -->

            <!-- LEFT NAVIGATION RAIL (ROW 1, COL 0)                           -->

            <!-- ============================================================= -->

            <Border Grid.Row="1"

                    Grid.Column="0"

                    Background="{StaticResource RailBackgroundBrush}"

                    BorderBrush="{StaticResource SubtleDividerBrush}"

                    BorderThickness="0,0,1,0">

                <Grid Margin="0,14,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <TextBlock Grid.Row="0"

                               Text="MENU"

                               Style="{StaticResource SectionEyebrowTextStyle}"

                               Margin="22,0,0,6"/>



                    <ListBox x:Name="NavRailList"

                             Grid.Row="1"

                             Background="Transparent"

                             BorderThickness="0"

                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                             ItemContainerStyle="{StaticResource NavigationItemStyle}"

                             SelectionChanged="NavRailList_SelectionChanged">

                        <ListBoxItem IsSelected="True" Tag="All">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="24"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"

                                           Text="&#xE80F;"

                                           FontFamily="{StaticResource IconFontFamily}"

                                           FontSize="14"

                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"

                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Margin="6,0,0,0">

                                    <TextBlock Text="Dashboard"

                                               FontFamily="{StaticResource FluentFontFamily}"

                                               FontSize="12.5"

                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Status, quick controls &amp; lock"

                                               FontFamily="{StaticResource FluentFontFamily}"

                                               FontSize="10.5"

                                               Foreground="{StaticResource TextMutedBrush}"/>

                                </StackPanel>

                            </Grid>

                        </ListBoxItem>



                        <ListBoxItem Tag="Files">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="24"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"

                                           Text="&#xE8B7;"

                                           FontFamily="{StaticResource IconFontFamily}"

                                           FontSize="14"

                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"

                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Margin="6,0,0,0">

                                    <TextBlock Text="File Transfer"

                                               FontFamily="{StaticResource FluentFontFamily}"

                                               FontSize="12.5"

                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Transfer files with your phone"

                                               FontFamily="{StaticResource FluentFontFamily}"

                                               FontSize="10.5"

                                               Foreground="{StaticResource TextMutedBrush}"/>

                                </StackPanel>

                            </Grid>

                        </ListBoxItem>

                    </ListBox>



                    <!-- User Account Card -->

                    <Border Grid.Row="3"
                            Margin="10,0,10,12"
                            Padding="10,9"
                            CornerRadius="8"
                            Background="{StaticResource GlassSurfaceSubtleBrush}"
                            BorderBrush="{StaticResource GlassSpecularBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="BorderAccountIcon" Grid.Column="0"
                                    Width="30" Height="30"
                                    CornerRadius="7"
                                    Background="{StaticResource AccentPillBackgroundBrush}"
                                    BorderBrush="{StaticResource AccentPillBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAccountIcon"
                                           Text="&#xE77B;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="13"
                                           Foreground="{StaticResource SystemAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="CURRENT ACCOUNT"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="8.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border x:Name="PillAccountType"
                                            DockPanel.Dock="Right"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Background="#14263E"
                                            BorderBrush="{StaticResource AccentPillBorderBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAccountTypeBadge"
                                                   Text="MICROSOFT"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SystemAccentBrush}"/>
                                    </Border>
                                </DockPanel>
                                <TextBlock x:Name="TxtUserType"
                                           Text="Detecting account..."
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtLocalAlias"
                                           Text="Local: ASUSP5\tirth"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="8.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,1,0,0"
                                           Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </Border>



            <!-- ============================================================= -->

            <!-- MAIN CONTENT CANVAS (ROW 1, COL 1)                            -->

            <!-- ============================================================= -->

            <Grid Grid.Row="1" Grid.Column="1">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <updates:UpdateBannerControl x:Name="AppUpdateBanner" Grid.Row="0"/>



                <Grid Grid.Row="1"

                      Margin="20,10,20,20">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1.08*"/>

                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="0.92*"/>

                </Grid.ColumnDefinitions>



                <!-- ========================================================= -->

                <!-- WORKSPACE B: DUAL-PANE FILE TRANSFER                      -->

                <!-- ========================================================= -->

                <Grid x:Name="FilesContainer"

                      Visibility="Collapsed"

                      Grid.Column="0"

                      Grid.ColumnSpan="3">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>



                    <!-- Local Windows Storage Pane -->

                    <Border Grid.Row="0" Grid.Column="0"

                            Style="{StaticResource GlassPanel}"

                            Margin="0"

                            Padding="18">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>



                            <!-- Pane Header -->

                            <Grid Grid.Row="0" Margin="0,0,0,12">

                                <StackPanel>

                                    <TextBlock Text="THIS PC"

                                               Style="{StaticResource SectionEyebrowTextStyle}"/>

                                    <TextBlock Text="Local Files"

                                               Style="{StaticResource CardTitleTextStyle}"/>

                                </StackPanel>

                            </Grid>



                            <!-- Address Bar -->

                            <Grid Grid.Row="1" Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnLocalUp"

                                        Grid.Column="0"

                                        Content="&#xE74A;"

                                        ToolTip="Up one level"

                                        FontFamily="{StaticResource IconFontFamily}"

                                        Width="36" Height="36"

                                        Margin="0,0,8,0"

                                        Padding="0"

                                        Click="BtnLocalUp_Click"/>

                                <TextBox x:Name="TxtLocalPath"

                                         Grid.Column="1"

                                         Height="36"

                                         VerticalContentAlignment="Center"

                                         Padding="10,0"

                                         FontSize="12.5"

                                         ToolTip="Current folder path (press Enter to open)"

                                         KeyDown="TxtLocalPath_KeyDown"/>

                            </Grid>



                            <!-- Directory ListView -->

                            <ListView x:Name="ListLocalFiles"

                                      Grid.Row="2"

                                      MouseDoubleClick="ListLocalFiles_MouseDoubleClick">

                                <ListView.View>

                                    <GridView>

                                        <GridViewColumn Header="Name" Width="230">

                                            <GridViewColumn.CellTemplate>

                                                <DataTemplate>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding Icon}"

                                                                   FontFamily="{StaticResource IconFontFamily}"

                                                                   FontSize="13"

                                                                   Foreground="{StaticResource SystemAccentBrush}"

                                                                   Margin="0,0,8,0"

                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Text="{Binding Name}"

                                                                   FontFamily="{StaticResource FluentFontFamily}"

                                                                   FontSize="12.5"

                                                                   Foreground="{StaticResource TextPrimaryBrush}"

                                                                   TextTrimming="CharacterEllipsis"

                                                                   VerticalAlignment="Center"/>

                                                    </StackPanel>

                                                </DataTemplate>

                                            </GridViewColumn.CellTemplate>

                                        </GridViewColumn>

                                        <GridViewColumn Header="Type" Width="75">

                                            <GridViewColumn.CellTemplate>

                                                <DataTemplate>

                                                    <TextBlock Text="{Binding Type}"

                                                               FontFamily="{StaticResource MonoFontFamily}"

                                                               FontSize="11"

                                                               Foreground="{StaticResource TextSecondaryBrush}"/>

                                                </DataTemplate>

                                            </GridViewColumn.CellTemplate>

                                        </GridViewColumn>

                                        <GridViewColumn Header="Size" Width="85">

                                            <GridViewColumn.CellTemplate>

                                                <DataTemplate>

                                                    <TextBlock Text="{Binding Size}"

                                                               FontFamily="{StaticResource MonoFontFamily}"

                                                               FontSize="11"

                                                               Foreground="{StaticResource TextMutedBrush}"/>

                                                </DataTemplate>

                                            </GridViewColumn.CellTemplate>

                                        </GridViewColumn>

                                    </GridView>

                                </ListView.View>

                            </ListView>



                            <!-- Transfer Action -->

                            <Button x:Name="BtnUpload"

                                    Grid.Row="3"

                                    Margin="0,12,0,0"

                                    Height="38"

                                    Style="{StaticResource AccentButton}"

                                    Click="BtnUpload_Click">

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <TextBlock Text="&#xE898;"

                                               FontFamily="{StaticResource IconFontFamily}"

                                               FontSize="13"

                                               VerticalAlignment="Center"

                                               Margin="0,0,8,0"/>

                                    <TextBlock Text="Send to Phone"

                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>



                    <!-- Remote Phone Storage Pane -->

                    <Border Grid.Row="0" Grid.Column="2"

                            Style="{StaticResource GlassPanel}"

                            Margin="0"

                            Padding="18">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>



                            <!-- Pane Header -->

                            <Grid Grid.Row="0" Margin="0,0,0,12">

                                <StackPanel>

                                    <TextBlock Text="CONNECTED PHONE"

                                               Style="{StaticResource SectionEyebrowTextStyle}"/>

                                    <TextBlock Text="Phone Storage"

                                               Style="{StaticResource CardTitleTextStyle}"/>

                                </StackPanel>

                            </Grid>



                            <!-- Address Bar -->

                            <Grid Grid.Row="1" Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnRemoteUp"

                                        Grid.Column="0"

                                        Content="&#xE74A;"

                                        ToolTip="Up one level"

                                        FontFamily="{StaticResource IconFontFamily}"

                                        Width="36" Height="36"

                                        Margin="0,0,8,0"

                                        Padding="0"

                                        Click="BtnRemoteUp_Click"/>

                                <TextBox x:Name="TxtRemotePath"

                                         Grid.Column="1"

                                         Height="36"

                                         VerticalContentAlignment="Center"

                                         Padding="10,0"

                                         FontSize="12.5"

                                         ToolTip="Current phone path (press Enter to open)"

                                         KeyDown="TxtRemotePath_KeyDown"/>

                                <Button x:Name="BtnRemoteRefresh"

                                        Grid.Column="2"

                                        Content="&#xE72C;"

                                        ToolTip="Refresh folder"

                                        FontFamily="{StaticResource IconFontFamily}"

                                        Width="36" Height="36"

                                        Margin="8,0,0,0"

                                        Padding="0"

                                        Click="BtnRemoteRefresh_Click"/>

                            </Grid>



                            <!-- Remote ListView -->

                            <ListView x:Name="ListRemoteFiles"

                                      Grid.Row="2"

                                      MouseDoubleClick="ListRemoteFiles_MouseDoubleClick">

                                <ListView.View>

                                    <GridView>

                                        <GridViewColumn Header="Name" Width="230">

                                            <GridViewColumn.CellTemplate>

                                                <DataTemplate>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding Icon}"

                                                                   FontFamily="{StaticResource IconFontFamily}"

                                                                   FontSize="13"

                                                                   Foreground="{StaticResource SystemAccentBrush}"

                                                                   Margin="0,0,8,0"

                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Text="{Binding Name}"

                                                                   FontFamily="{StaticResource FluentFontFamily}"

                                                                   FontSize="12.5"

                                                                   Foreground="{StaticResource TextPrimaryBrush}"

                                                                   TextTrimming="CharacterEllipsis"

                                                                   VerticalAlignment="Center"/>

                                                    </StackPanel>

                                                </DataTemplate>

                                            </GridViewColumn.CellTemplate>

                                        </GridViewColumn>

                                        <GridViewColumn Header="Type" Width="75">

                                            <GridViewColumn.CellTemplate>

                                                <DataTemplate>

                                                    <TextBlock Text="{Binding Type}"

                                                               FontFamily="{StaticResource MonoFontFamily}"

                                                               FontSize="11"

                                                               Foreground="{StaticResource TextSecondaryBrush}"/>

                                                </DataTemplate>

                                            </GridViewColumn.CellTemplate>

                                        </GridViewColumn>

                                        <GridViewColumn Header="Size" Width="85">

                                            <GridViewColumn.CellTemplate>

                                                <DataTemplate>

                                                    <TextBlock Text="{Binding Size}"

                                                               FontFamily="{StaticResource MonoFontFamily}"

                                                               FontSize="11"

                                                               Foreground="{StaticResource TextMutedBrush}"/>

                                                </DataTemplate>

                                            </GridViewColumn.CellTemplate>

                                        </GridViewColumn>

                                    </GridView>

                                </ListView.View>

                            </ListView>



                            <!-- Transfer Action -->

                            <Button x:Name="BtnDownload"

                                    Grid.Row="3"

                                    Margin="0,12,0,0"

                                    Height="38"

                                    Style="{StaticResource AccentButton}"

                                    Click="BtnDownload_Click">

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <TextBlock Text="&#xE896;"

                                               FontFamily="{StaticResource IconFontFamily}"

                                               FontSize="13"

                                               VerticalAlignment="Center"

                                               Margin="0,0,8,0"/>

                                    <TextBlock Text="Download to PC"

                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>

                    <!-- File Transfer Progress & Status Banner -->
                    <Border x:Name="CardFileTransferProgress"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Style="{StaticResource GlassPanel}"
                            Margin="0,14,0,0"
                            Padding="16,12"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.RowSpan="2" Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentPillBackgroundBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="IconTransferDirection" Text="&#xE898;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource SystemAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTransferFileName" Text="Transfer in progress..." FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtTransferMetrics" Text="Connecting..." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnOpenSavedLocation" Content="Open Folder" Style="{StaticResource StandardButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnOpenSavedLocation_Click"/>
                                <Button x:Name="BtnDismissTransferProgress" Content="&#xE711;" FontFamily="{StaticResource IconFontFamily}" Style="{StaticResource StandardButton}" Width="28" Height="28" Padding="0" Visibility="Collapsed" Click="BtnDismissTransferProgress_Click"/>
                            </StackPanel>

                            <ProgressBar x:Name="ProgressFileTransfer" Grid.Row="1" Grid.Column="1" Height="5" Margin="0,8,12,0" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource SystemAccentBrush}"/>
                        </Grid>
                    </Border>

                </Grid>



                <!-- ========================================================= -->

                <!-- WORKSPACE A (LEFT COLUMN): STATUS, CONTROLS & UNLOCK      -->

                <!-- ========================================================= -->

                <ScrollViewer x:Name="LeftScrollViewer"

                              Grid.Column="0"

                              VerticalScrollBarVisibility="Auto"

                              HorizontalScrollBarVisibility="Disabled"

                              Padding="0,0,4,0">

                    <StackPanel>



                        <!-- Pairing Request Card -->

                        <Border x:Name="CardPairing"

                                Style="{StaticResource GlassPanel}"

                                Visibility="Collapsed"

                                BorderBrush="{StaticResource SystemAccentBrush}"

                                BorderThickness="1.5"

                                Margin="0,0,0,14">

                            <StackPanel>

                                <Grid Margin="0,0,0,8">

                                    <StackPanel>

                                        <TextBlock Text="DEVICE PAIRING"

                                                   Style="{StaticResource SectionEyebrowTextStyle}"

                                                   Foreground="{StaticResource SystemAccentBrush}"/>

                                        <TextBlock x:Name="TxtPairingDeviceTitle"

                                                   Text="Pairing Request"

                                                   Style="{StaticResource CardTitleTextStyle}"/>

                                    </StackPanel>

                                    <Border Style="{StaticResource BadgePillBorderStyle}"

                                            HorizontalAlignment="Right"

                                            VerticalAlignment="Top"

                                            BorderBrush="{StaticResource SystemAccentBrush}">

                                        <TextBlock Text="ACTION REQUIRED"

                                                   FontFamily="{StaticResource MonoFontFamily}"

                                                   FontSize="9.5"

                                                   FontWeight="SemiBold"

                                                   Foreground="{StaticResource SystemAccentBrush}"/>

                                    </Border>

                                </Grid>

                                <TextBlock x:Name="TxtPairingInstructions"

                                           Text="A phone is attempting to pair with this PC. Enter the 6-digit PIN below on your phone:"

                                           FontFamily="{StaticResource FluentFontFamily}"

                                           FontSize="12"

                                           Foreground="{StaticResource TextSecondaryBrush}"

                                           Margin="0,0,0,12"

                                           TextWrapping="Wrap"/>

                                <Border Background="{StaticResource RecessedWellBrush}"

                                        BorderBrush="{StaticResource SystemAccentBrush}"

                                        BorderThickness="1"

                                        CornerRadius="8"

                                        Padding="16,10"

                                        HorizontalAlignment="Center"

                                        Margin="0,0,0,12">

                                    <TextBlock x:Name="TxtPairingPin"

                                               Text="------"

                                               FontFamily="{StaticResource MonoFontFamily}"

                                               FontSize="30"

                                               FontWeight="Bold"

                                               Foreground="{StaticResource TextPrimaryBrush}"

                                               HorizontalAlignment="Center"

                                               VerticalAlignment="Center"/>

                                </Border>

                                <Button x:Name="BtnDismissPairing"

                                        Style="{StaticResource SubtleIconButton}"

                                        HorizontalAlignment="Right"

                                        Click="BtnDismissPairing_Click">

                                    <TextBlock Text="Dismiss" FontSize="11" Margin="6,2"/>

                                </Button>

                            </StackPanel>

                        </Border>



<Border x:Name="CardPipeline" Style="{StaticResource GlassPanel}">

                            <StackPanel>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>



                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="PHONE CONNECTION"

                                                   Style="{StaticResource SectionEyebrowTextStyle}"/>

                                        <TextBlock Text="Wireless Link &amp; Proximity"

                                                   Style="{StaticResource CardTitleTextStyle}"/>

                                    </StackPanel>



                                    <Border Grid.Column="1"

                                            Background="{StaticResource RecessedWellBrush}"

                                            BorderBrush="{StaticResource SubtleDividerBrush}"

                                            BorderThickness="1"

                                            CornerRadius="14"

                                            Padding="10,4"

                                            VerticalAlignment="Top">

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <Grid Width="16" Height="16" VerticalAlignment="Center">

                                                <Ellipse x:Name="IndicatorHalo"

                                                         Width="16" Height="16"

                                                         Fill="{StaticResource CriticalHaloBrush}"/>

                                                <Ellipse x:Name="IndicatorNode"

                                                         Width="8" Height="8"

                                                         Fill="{StaticResource StatusCriticalBrush}"

                                                         HorizontalAlignment="Center"

                                                         VerticalAlignment="Center"/>

                                            </Grid>

                                            <TextBlock Text="LIVE STATUS"

                                                       FontFamily="{StaticResource MonoFontFamily}"

                                                       FontSize="9.5"

                                                       FontWeight="SemiBold"

                                                       Foreground="{StaticResource TextSecondaryBrush}"

                                                       Margin="6,0,0,0"

                                                       VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Border>

                                </Grid>



                                <!-- Status Readout Well -->

                                <Border Style="{StaticResource RecessedWellStyle}"

                                        Margin="0,14,0,0">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>



                                        <Border Grid.Column="0"

                                                Width="36" Height="36"

                                                CornerRadius="8"

                                                Background="#12FFFFFF"

                                                BorderBrush="{StaticResource SubtleDividerBrush}"

                                                BorderThickness="1"

                                                Margin="0,0,12,0">

                                            <TextBlock Text="&#xE839;"

                                                       FontFamily="{StaticResource IconFontFamily}"

                                                       FontSize="15"

                                                       Foreground="{StaticResource SystemAccentBrush}"

                                                       HorizontalAlignment="Center"

                                                       VerticalAlignment="Center"/>

                                        </Border>



                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                            <TextBlock Text="CONNECTION STATUS"

                                                       FontFamily="{StaticResource MonoFontFamily}"

                                                       FontSize="9.5"

                                                       Foreground="{StaticResource TextMutedBrush}"/>

                                            <TextBlock x:Name="TxtStatus"

                                                       Text="Connecting to Tether service..."

                                                       FontFamily="{StaticResource MonoFontFamily}"

                                                       FontSize="13"

                                                       FontWeight="Bold"

                                                       Foreground="{StaticResource TextPrimaryBrush}"

                                                       Margin="0,2,0,0"/>

                                        </StackPanel>



                                        <StackPanel Grid.Column="2"

                                                    VerticalAlignment="Center"

                                                    HorizontalAlignment="Right">

                                            <TextBlock Text="BACKGROUND SERVICE"

                                                       FontFamily="{StaticResource MonoFontFamily}"

                                                       FontSize="9"

                                                       Foreground="{StaticResource TextMutedBrush}"

                                                       HorizontalAlignment="Right"/>

                                            <TextBlock x:Name="TxtStatusSub"

                                                       Text="Starting..."

                                                       FontFamily="{StaticResource MonoFontFamily}"

                                                       FontSize="10.5"

                                                       Foreground="{StaticResource TextSecondaryBrush}"

                                                       HorizontalAlignment="Right"

                                                       Margin="0,2,0,0"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </StackPanel>

                        </Border>



                        <!-- 2. Volume & Brightness Controls -->

                        <Border x:Name="CardHardware" Style="{StaticResource GlassPanel}">

                            <StackPanel>

                                <Grid Margin="0,0,0,14">

                                    <StackPanel>

                                        <TextBlock Text="QUICK CONTROLS"

                                                   Style="{StaticResource SectionEyebrowTextStyle}"/>

                                        <TextBlock Text="Volume &amp; Brightness"

                                                   Style="{StaticResource CardTitleTextStyle}"/>

                                    </StackPanel>

                                </Grid>



                                <!-- Volume Slider -->

                                <Border Style="{StaticResource RecessedWellStyle}"

                                        Margin="0,0,0,10">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,8">

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <TextBlock Text="&#xE767;"

                                                           FontFamily="{StaticResource IconFontFamily}"

                                                           FontSize="13"

                                                           Foreground="{StaticResource SystemAccentBrush}"

                                                           VerticalAlignment="Center"

                                                           Margin="0,0,8,0"/>

                                                <TextBlock Text="PC Master Volume"

                                                           FontFamily="{StaticResource FluentFontFamily}"

                                                           FontSize="12.5"

                                                           FontWeight="Medium"

                                                           Foreground="{StaticResource TextPrimaryBrush}"

                                                           VerticalAlignment="Center"/>

                                            </StackPanel>



                                            <Border Style="{StaticResource BadgePillBorderStyle}"

                                                    HorizontalAlignment="Right">

                                                <TextBlock x:Name="TxtVolumeValue"

                                                           Text="0%"

                                                           FontFamily="{StaticResource MonoFontFamily}"

                                                           FontSize="11"

                                                           FontWeight="SemiBold"

                                                           Foreground="{StaticResource TextAccentBrush}"/>

                                            </Border>

                                        </Grid>

                                        <Slider x:Name="SliderVolume"

                                                Minimum="0"

                                                Maximum="100"

                                                AutoToolTipPlacement="TopLeft"

                                                AutoToolTipPrecision="0"

                                                ValueChanged="SliderVolume_ValueChanged"/>

                                    </StackPanel>

                                </Border>



                                <!-- Brightness Slider -->

                                <Border Style="{StaticResource RecessedWellStyle}">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,8">

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <TextBlock Text="&#xE706;"

                                                           FontFamily="{StaticResource IconFontFamily}"

                                                           FontSize="13"

                                                           Foreground="{StaticResource SystemAccentBrush}"

                                                           VerticalAlignment="Center"

                                                           Margin="0,0,8,0"/>

                                                <TextBlock Text="PC Screen Brightness"

                                                           FontFamily="{StaticResource FluentFontFamily}"

                                                           FontSize="12.5"

                                                           FontWeight="Medium"

                                                           Foreground="{StaticResource TextPrimaryBrush}"

                                                           VerticalAlignment="Center"/>

                                            </StackPanel>



                                            <Border Style="{StaticResource BadgePillBorderStyle}"

                                                    HorizontalAlignment="Right">

                                                <TextBlock x:Name="TxtBrightnessValue"

                                                           Text="0%"

                                                           FontFamily="{StaticResource MonoFontFamily}"

                                                           FontSize="11"

                                                           FontWeight="SemiBold"

                                                           Foreground="{StaticResource TextAccentBrush}"/>

                                            </Border>

                                        </Grid>

                                        <Slider x:Name="SliderBrightness"

                                                Minimum="0"

                                                Maximum="100"

                                                AutoToolTipPlacement="TopLeft"

                                                AutoToolTipPrecision="0"

                                                ValueChanged="SliderBrightness_ValueChanged"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>



                        <!-- 3. Auto-Unlock Password Card -->
                        <Border x:Name="CardVault"
                                Style="{StaticResource GlassPanel}"
                                Margin="0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtVaultEyebrow"
                                                   Text="AUTO-UNLOCK SETUP"
                                                   Style="{StaticResource SectionEyebrowTextStyle}"/>
                                        <TextBlock x:Name="TxtVaultTitle"
                                                   Text="Save Windows Password"
                                                   Style="{StaticResource CardTitleTextStyle}"/>
                                    </StackPanel>

                                    <Border Style="{StaticResource BadgePillBorderStyle}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="TxtVaultBadge"
                                                   Text="SECURE STORAGE"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextAccentBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="TxtVaultDescription"
                                           Text="Enter your Windows sign-in password once so Tether can unlock your PC automatically when your phone is nearby. Your password stays encrypted safely on this computer."
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>

                                <!-- Passwordless MSA Guidance Notice (Dynamically visible for Microsoft Accounts) -->
                                <Border x:Name="PnlPasswordlessMsaNotice"
                                        Background="#0A1828"
                                        BorderBrush="#1E3A5F"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,10"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE946;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource SystemAccentBrush}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,1,8,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Passwordless Account or Windows Hello PIN?"
                                                       FontFamily="{StaticResource FluentFontFamily}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Windows auto-unlock requires your underlying Microsoft Account password. If your account is passwordless (Hello PIN or biometrics only), please add a password in Account Security."
                                                       FontFamily="{StaticResource FluentFontFamily}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,4,0,0">
                                                <Hyperlink NavigateUri="https://account.microsoft.com/security"
                                                           RequestNavigate="Hyperlink_RequestNavigate"
                                                           Foreground="{StaticResource SystemAccentBrush}">
                                                    <Run Text="Manage Microsoft Account Security ↗"
                                                         FontSize="10.5"
                                                         FontFamily="{StaticResource FluentFontFamily}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <PasswordBox x:Name="TxtPassword"
                                                     Height="36"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="TxtPassword_KeyDown"
                                                     PasswordChanged="TxtPassword_PasswordChanged"/>
                                        <TextBlock x:Name="TxtPasswordPlaceholder"
                                                   Text="Enter Windows password"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   FontFamily="{StaticResource FluentFontFamily}"
                                                   VerticalAlignment="Center"
                                                   Margin="14,0,0,0"
                                                   IsHitTestVisible="False"/>
                                    </Grid>

                                    <Button x:Name="BtnCommitVault"
                                            Grid.Column="2"
                                            Style="{StaticResource AccentButton}"
                                            Height="36"
                                            Padding="18,0"
                                            Click="BtnCommitVault_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8D7;"
                                                       FontFamily="{StaticResource IconFontFamily}"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtCommitVaultButton"
                                                       Text="Save Password"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="TxtVaultValidationMsg"
                                           Foreground="{StaticResource StatusCriticalBrush}"
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="11"
                                           Margin="0,6,0,0"
                                           Visibility="Collapsed"
                                           TextWrapping="Wrap"/>

                                <!-- Security & Privacy Polish Reassurance -->
                                <Border Background="#080E18"
                                        BorderBrush="#172436"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="9,6"
                                        Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE72E;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource StatusHealthyBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="TxtVaultSecurityNote"
                                                   Text="Credentials are encrypted on-device via Windows DPAPI and never transmitted over the network."
                                                   FontFamily="{StaticResource FluentFontFamily}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 3B. Fallback PIN / Password Card -->
                        <Border x:Name="CardFallbackAuth"
                                Style="{StaticResource GlassPanel}"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="SECURITY FALLBACK"
                                                   Style="{StaticResource SectionEyebrowTextStyle}"/>
                                        <TextBlock Text="Fallback Authentication"
                                                   Style="{StaticResource CardTitleTextStyle}"/>
                                    </StackPanel>
                                    <Border x:Name="PillFallbackAuthBadge"
                                            Style="{StaticResource BadgePillBorderStyle}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="TxtFallbackAuthBadge"
                                                   Text="DISABLED"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Configure a local Fallback PIN or Password to unlock this PC with the Tether Credential Provider even if your phone is away or offline."
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"
                                           TextWrapping="Wrap"/>

                                <!-- 1. Active Configured Status Summary Panel -->
                                <Border x:Name="PnlFallbackActiveSummary"
                                        Visibility="Collapsed"
                                        Background="#0A38BDF8"
                                        BorderBrush="#3038BDF8"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="36" Height="36"
                                                    CornerRadius="18"
                                                    Background="#1510B981"
                                                    BorderBrush="#4010B981"
                                                    BorderThickness="1">
                                                <TextBlock Text="&#xE73E;"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="16"
                                                           Foreground="{StaticResource StatusHealthyBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtFallbackActiveTitle"
                                                           Text="Fallback Credential Active"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TxtFallbackActiveDesc"
                                                           Text="Local workstation fallback unlock is enabled and protected."
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="BtnForgotFallbackCred"
                                                    Style="{StaticResource StandardButton}"
                                                    Height="34"
                                                    Padding="16,0"
                                                    Click="BtnForgotFallbackCred_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE897;"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,7,0"/>
                                                    <TextBlock x:Name="TxtForgotFallbackCredLabel"
                                                               Text="Forgot Password"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Forgot Password Recovery Flow Panel -->
                                <Border x:Name="PnlForgotPasswordRecovery"
                                        Visibility="Collapsed"
                                        Background="#0F172A"
                                        BorderBrush="{StaticResource SystemAccentBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Padding="14,14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="IDENTITY RECOVERY"
                                                   Style="{StaticResource SectionEyebrowTextStyle}"
                                                   Foreground="{StaticResource SystemAccentBrush}"/>
                                        <TextBlock Text="Recover Forgotten Credential"
                                                   Style="{StaticResource CardTitleTextStyle}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="Both security verifications below are mandatory to recover your fallback credential."
                                                   FontFamily="{StaticResource FluentFontFamily}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,14"
                                                   TextWrapping="Wrap"/>

                                        <!-- Requirement 1: Phone Unlock Confirmation -->
                                        <Border Background="#0D1524"
                                                BorderBrush="#1F293D"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="12,10"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="&#xE8EA;"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="18"
                                                           Foreground="{StaticResource SystemAccentBrush}"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="1. Phone Unlock Command"
                                                               FontFamily="{StaticResource FluentFontFamily}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Open the Tether app on your phone and tap 'Unlock PC'."
                                                               FontFamily="{StaticResource FluentFontFamily}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border x:Name="PillForgotPhoneStatus"
                                                        Grid.Column="3"
                                                        Style="{StaticResource BadgePillBorderStyle}"
                                                        VerticalAlignment="Center"
                                                        Padding="8,3">
                                                    <TextBlock x:Name="TxtForgotPhoneStatus"
                                                               Text="WAITING FOR UNLOCK..."
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource StatusDegradedBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Requirement 2: Registered Windows Password -->
                                        <Border Background="#0D1524"
                                                BorderBrush="#1F293D"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="12,10"
                                                Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="&#xE72E;"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="18"
                                                               Foreground="{StaticResource SystemAccentBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtForgotRequirementTitle"
                                                                   Text="2. Registered Windows Password"
                                                                   FontFamily="{StaticResource FluentFontFamily}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock x:Name="TxtForgotRequirementDesc"
                                                                   Text="Enter your Windows account password to verify device authorization."
                                                                   FontFamily="{StaticResource FluentFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <PasswordBox x:Name="TxtForgotWindowsPassword"
                                                             Height="36"
                                                             VerticalContentAlignment="Center"
                                                             KeyDown="TxtForgotWindowsPassword_KeyDown"/>
                                                <TextBlock x:Name="TxtForgotWindowsError"
                                                           Foreground="{StaticResource StatusCriticalBrush}"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"
                                                           Visibility="Collapsed"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Recovery Action Buttons -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnCancelForgotRecovery"
                                                    Grid.Column="0"
                                                    Style="{StaticResource StandardButton}"
                                                    HorizontalAlignment="Left"
                                                    Height="36"
                                                    Padding="16,0"
                                                    Click="BtnCancelForgotRecovery_Click">
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </Button>

                                            <Button x:Name="BtnVerifyForgotRecovery"
                                                    Grid.Column="2"
                                                    Style="{StaticResource AccentButton}"
                                                    Height="36"
                                                    Padding="18,0"
                                                    Click="BtnVerifyForgotRecovery_Click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE73E;"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="12.5"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="Verify &amp; Unlock"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Fallback Configuration & Entry Panel (Shown when editing or disabled) -->
                                <StackPanel x:Name="PnlFallbackConfig">
                                    <!-- Method selector dropdown -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Authentication Mode"
                                                   FontFamily="{StaticResource FluentFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbFallbackAuthMethod"
                                                  Grid.Column="2"
                                                  Height="34"
                                                  SelectedIndex="0"
                                                  SelectionChanged="CmbFallbackAuthMethod_SelectionChanged">
                                            <ComboBoxItem Content="Disabled"/>
                                            <ComboBoxItem Content="Fallback PIN (Min 8 Digits)"/>
                                            <ComboBoxItem Content="Fallback Password (Min 8 Chars)"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Credential Entry Panel -->
                                    <StackPanel x:Name="PnlFallbackCredentialInputs" Visibility="Collapsed">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Name="LblFallbackCred"
                                                           Text="New Credential"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <PasswordBox x:Name="TxtFallbackPassword"
                                                             Height="36"
                                                             VerticalContentAlignment="Center"
                                                             PasswordChanged="TxtFallbackPassword_PasswordChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Confirm Credential"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <PasswordBox x:Name="TxtFallbackPasswordConfirm"
                                                             Height="36"
                                                             VerticalContentAlignment="Center"
                                                             PasswordChanged="TxtFallbackPassword_PasswordChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Strength Meter & Feedback -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="PillFallbackStrength"
                                                    Style="{StaticResource NeutralBadgePillStyle}"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtFallbackStrengthBadge"
                                                           Text="NONE"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </Border>
                                            <TextBlock x:Name="TxtFallbackStrengthFeedback"
                                                       Grid.Column="2"
                                                       Text="Requires minimum 8 characters with non-predictable patterns."
                                                       FontFamily="{StaticResource FluentFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnCancelFallbackReset"
                                                Grid.Column="0"
                                                Style="{StaticResource StandardButton}"
                                                Height="36"
                                                Padding="16,0"
                                                Visibility="Collapsed"
                                                Click="BtnCancelFallbackReset_Click">
                                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                        </Button>

                                        <Button x:Name="BtnSaveFallbackAuth"
                                                Grid.Column="2"
                                                Style="{StaticResource AccentButton}"
                                                Height="36"
                                                Padding="18,0"
                                                Click="BtnSaveFallbackAuth_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE8D7;"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="12.5"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock x:Name="TxtSaveFallbackAuthLabel"
                                                           Text="Save Configuration"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 4. Paired Devices Card -->

                        <Border x:Name="CardPairedDevices"

                                Style="{StaticResource GlassPanel}"

                                Margin="0,14,0,0">

                            <StackPanel>

                                <Grid Margin="0,0,0,6">

                                    <StackPanel>

                                        <TextBlock Text="TRUSTED DEVICES"

                                                   Style="{StaticResource SectionEyebrowTextStyle}"/>

                                        <TextBlock Text="Paired Phones"

                                                   Style="{StaticResource CardTitleTextStyle}"/>

                                    </StackPanel>

                                    <Border Style="{StaticResource BadgePillBorderStyle}"

                                            HorizontalAlignment="Right"

                                            VerticalAlignment="Top">

                                        <TextBlock x:Name="TxtPairedCount"

                                                   Text="0 PAIRED"

                                                   FontFamily="{StaticResource MonoFontFamily}"

                                                   FontSize="9.5"

                                                   FontWeight="SemiBold"

                                                   Foreground="{StaticResource TextAccentBrush}"/>

                                    </Border>

                                </Grid>

                                <TextBlock Text="Devices authorized to securely connect, unlock, and exchange files with this PC."

                                           FontFamily="{StaticResource FluentFontFamily}"

                                           FontSize="12"

                                           Foreground="{StaticResource TextSecondaryBrush}"

                                           Margin="0,0,0,10"

                                           TextWrapping="Wrap"/>

                                <ItemsControl x:Name="PairedDevicesList">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border Background="{StaticResource RecessedWellBrush}"

                                                    BorderBrush="{StaticResource SubtleDividerBrush}"

                                                    BorderThickness="1"

                                                    CornerRadius="8"

                                                    Padding="10,8"

                                                    Margin="0,0,0,6">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="Auto"/>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="Auto"/>

                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"

                                                            Width="30" Height="30"

                                                            CornerRadius="6"

                                                            Background="#12FFFFFF"

                                                            Margin="0,0,10,0">

                                                        <TextBlock Text="&#xE8EA;"

                                                                   FontFamily="{StaticResource IconFontFamily}"

                                                                   FontSize="13"

                                                                   Foreground="{StaticResource SystemAccentBrush}"

                                                                   HorizontalAlignment="Center"

                                                                   VerticalAlignment="Center"/>

                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding DisplayName}"

                                                                   FontFamily="{StaticResource FluentFontFamily}"

                                                                   FontSize="12.5"

                                                                   FontWeight="SemiBold"

                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                                        <TextBlock Text="{Binding FingerprintPreview}"

                                                                   FontFamily="{StaticResource MonoFontFamily}"

                                                                   FontSize="10"

                                                                   Foreground="{StaticResource TextMutedBrush}"/>

                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                                        <Button Style="{StaticResource SubtleIconButton}"

                                                                VerticalAlignment="Center"

                                                                Margin="0,0,6,0"

                                                                Padding="6,4"

                                                                ToolTip="Copy full SHA-256 fingerprint"

                                                                Tag="{Binding Fingerprint}"

                                                                Click="BtnCopyFingerprint_Click">

                                                            <TextBlock Text="Copy"

                                                                       Foreground="{StaticResource TextSecondaryBrush}"

                                                                       FontSize="11"/>

                                                        </Button>

                                                        <Button Style="{StaticResource SubtleIconButton}"

                                                                VerticalAlignment="Center"

                                                                Padding="8,4"

                                                                Tag="{Binding Fingerprint}"

                                                                Click="BtnUnpairDevice_Click">

                                                            <TextBlock Text="Revoke"

                                                                       Foreground="{StaticResource StatusCriticalBrush}"

                                                                       FontSize="11"/>

                                                        </Button>

                                                    </StackPanel>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <TextBlock x:Name="TxtNoPairedDevices"

                                           Text="No phones paired yet. Open the Tether companion app on your phone to pair."

                                           FontFamily="{StaticResource FluentFontFamily}"

                                           FontSize="11.5"

                                           FontStyle="Italic"

                                           Foreground="{StaticResource TextMutedBrush}"

                                           Margin="4,4,0,0"/>

                            </StackPanel>

                        </Border>



                    </StackPanel>

                </ScrollViewer>



                <!-- ========================================================= -->

                <!-- WORKSPACE A (RIGHT COLUMN): RECENT ACTIVITY & ACTIONS     -->

                <!-- ========================================================= -->

                <Grid x:Name="RightColumnGrid" Grid.Column="2">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <!-- Activity Console -->

                    <Border Grid.Row="0"

                            Style="{StaticResource GlassPanel}"

                            Padding="18"

                            Margin="0">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>



                            <!-- Console Header -->

                            <Grid Grid.Row="0" Margin="0,0,0,12">

                                <StackPanel>

                                    <TextBlock Text="ACTIVITY"

                                               Style="{StaticResource SectionEyebrowTextStyle}"/>

                                    <TextBlock Text="Recent Activity &amp; Logs"

                                               Style="{StaticResource CardTitleTextStyle}"/>

                                </StackPanel>



                                <StackPanel Orientation="Horizontal"

                                            HorizontalAlignment="Right"

                                            VerticalAlignment="Center">

                                    <Button x:Name="BtnCopyLogs"

                                            Style="{StaticResource SubtleIconButton}"

                                            Margin="0,0,6,0"

                                            ToolTip="Copy log to clipboard"

                                            Click="BtnCopyLogs_Click">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="&#xE8C8;"

                                                       FontFamily="{StaticResource IconFontFamily}"

                                                       FontSize="11"

                                                       VerticalAlignment="Center"

                                                       Margin="0,0,5,0"/>

                                            <TextBlock Text="Copy"

                                                       FontSize="11"

                                                       VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Button>



                                    <Button x:Name="BtnClearLogs"

                                            Style="{StaticResource SubtleIconButton}"

                                            Margin="0,0,8,0"

                                            ToolTip="Clear activity log"

                                            Click="BtnClearLogs_Click">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="&#xE74D;"

                                                       FontFamily="{StaticResource IconFontFamily}"

                                                       FontSize="11"

                                                       VerticalAlignment="Center"

                                                       Margin="0,0,5,0"/>

                                            <TextBlock Text="Clear"

                                                       FontSize="11"

                                                       VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Button>



                                    <Border Style="{StaticResource NeutralBadgePillStyle}"

                                            Padding="8,4">

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <Ellipse Width="6" Height="6"

                                                     Fill="{StaticResource StatusHealthyBrush}"

                                                     VerticalAlignment="Center"

                                                     Margin="0,0,6,0"/>

                                            <TextBlock x:Name="TxtLogCount"

                                                       Text="0 / 250"

                                                       FontFamily="{StaticResource MonoFontFamily}"

                                                       FontSize="10"

                                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </Grid>



                            <!-- Live Alerts Feed & Temporary Notifications -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource TerminalBackgroundBrush}"
                                    BorderBrush="{StaticResource TerminalBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8">
                                <Grid>
                                    <!-- Empty state when no live alerts active -->
                                    <StackPanel x:Name="PnlNoNotifications"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Visibility="Visible">
                                        <Border Width="44" Height="44"
                                                CornerRadius="22"
                                                Background="#0D38BDF8"
                                                BorderBrush="#2638BDF8"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,10">
                                            <TextBlock Text="&#xE890;"
                                                       FontFamily="{StaticResource IconFontFamily}"
                                                       FontSize="18"
                                                       Foreground="{StaticResource TextAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Live System Notifications"
                                                   FontFamily="{StaticResource FluentFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="Real-time session alerts and security notices appear here automatically."
                                                   FontFamily="{StaticResource FluentFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="240"/>
                                    </StackPanel>

                                    <!-- Active Notifications feed (stacked toasts) -->
                                    <ScrollViewer x:Name="NotificationScrollViewer"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="NotificationItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8"
                                                            CornerRadius="8"
                                                            Background="{Binding BackgroundBrush}"
                                                            BorderBrush="{Binding BorderBrush}"
                                                            BorderThickness="1"
                                                            Padding="12,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Width="26" Height="26"
                                                                    CornerRadius="13"
                                                                    Background="{Binding BadgeBackgroundBrush}"
                                                                    BorderBrush="{Binding BorderBrush}"
                                                                    BorderThickness="1"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Icon}"
                                                                           FontFamily="{StaticResource IconFontFamily}"
                                                                           FontSize="11"
                                                                           Foreground="{Binding AccentBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Message}"
                                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding FormattedTime}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="9.5"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Top"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                        </Grid>

                    </Border>



                    <!-- Bottom Actions -->

                    <Grid Grid.Row="1" Margin="0,12,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>



                        <Button x:Name="BtnRestartService"

                                Grid.Column="0"

                                Height="42"

                                Style="{StaticResource AccentButton}"

                                Click="BtnRestartService_Click">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <TextBlock Text="&#xE72C;"

                                           FontFamily="{StaticResource IconFontFamily}"

                                           FontSize="13"

                                           VerticalAlignment="Center"

                                           Margin="0,0,8,0"/>

                                <TextBlock Text="Restart Tether Service"

                                           FontFamily="{StaticResource FluentFontFamily}"

                                           FontSize="12.5"

                                           FontWeight="SemiBold"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>



                        <Button x:Name="BtnLockdownOverride"

                                Grid.Column="2"

                                Height="42"

                                Style="{StaticResource DestructiveButton}"

                                Click="BtnLockdownOverride_Click">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <TextBlock Text="&#xE72E;"

                                           FontFamily="{StaticResource IconFontFamily}"

                                           FontSize="13"

                                           VerticalAlignment="Center"

                                           Margin="0,0,8,0"/>

                                <TextBlock Text="Lock PC Now"

                                           FontFamily="{StaticResource FluentFontFamily}"

                                           FontSize="12.5"

                                           FontWeight="SemiBold"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                </Grid>



            </Grid>

            </Grid>

        </Grid>

    </Border>

</Window>
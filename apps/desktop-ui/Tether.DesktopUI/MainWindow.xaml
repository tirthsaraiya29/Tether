<Window x:Class="Tether.DesktopUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tether Desktop Manager" 
        Height="800" Width="1100" 
        MinHeight="720" MinWidth="1000"
        Background="{StaticResource WindowBackgroundBrush}" 
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="LayoutRoot" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="0.96" ScaleY="0.96"/>
                <TranslateTransform x:Name="WindowTranslate" Y="20"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="#1A1A1A" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource SystemAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="TETHER" FontFamily="{StaticResource FluentDisplayFontFamily}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,16,0,0" ItemContainerStyle="{StaticResource NavigationItemStyle}">
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEEA3;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Dashboard" FontFamily="{StaticResource FluentFontFamily}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE702;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Pairing Engine" FontFamily="{StaticResource FluentFontFamily}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE95A;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Hardware Controls" FontFamily="{StaticResource FluentFontFamily}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Settings Configuration" FontFamily="{StaticResource FluentFontFamily}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <Border Grid.Row="2" Padding="16" BorderBrush="#2B2B2B" BorderThickness="0,1,0,0" Background="#161616">
                    <StackPanel>
                        <TextBlock x:Name="TxtUserType" Text="DOMAIN UNRESOLVED" FontFamily="{StaticResource FluentFontFamily}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1" Background="{StaticResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="False"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="10" Click="BtnMinimize_Click"/>
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="10" Click="BtnMaximize_Click"/>
                <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE10A;" FontFamily="Segoe Fluent Icons" FontSize="10" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,24,0">
                <StackPanel>
                    <Border Style="{StaticResource FluentPanelCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Core Security Network Pipeline" FontFamily="{StaticResource FluentDisplayFontFamily}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtStatus" Text="WAITING FOR SERVICE PIPELINE..." FontFamily="{StaticResource FluentFontFamily}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtRssi" Text="RSSI NODE: -- dBm" FontFamily="{StaticResource FluentFontFamily}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            </StackPanel>

                            <Ellipse x:Name="IndicatorNode" Grid.Column="1" Width="12" Height="12" Fill="{StaticResource StatusCriticalBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FluentPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Hardware Device Layer Integrations" FontFamily="{StaticResource FluentDisplayFontFamily}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="System Master Volume" FontFamily="{StaticResource FluentFontFamily}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtVolumeValue" Text="0%" FontFamily="{StaticResource FluentFontFamily}" FontSize="13" Foreground="{StaticResource SystemAccentBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="SliderVolume" ValueChanged="SliderVolume_ValueChanged"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Display Matrix Luminescence" FontFamily="{StaticResource FluentFontFamily}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtBrightnessValue" Text="0%" FontFamily="{StaticResource FluentFontFamily}" FontSize="13" Foreground="{StaticResource SystemAccentBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="SliderBrightness" ValueChanged="SliderBrightness_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FluentPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Cryptographic Companion Provisioning" FontFamily="{StaticResource FluentDisplayFontFamily}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Enter the public key payload from your paired companion peripheral device." FontFamily="{StaticResource FluentFontFamily}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <TextBox x:Name="TxtPublicKey" Margin="0,0,0,12"/>

                            <Grid>
                                <Button Content="Provision Device" HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Click="BtnProvision_Click"/>
                                <TextBlock x:Name="TxtProvisionStatus" Text="Not provisioned" FontFamily="{StaticResource FluentFontFamily}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FluentPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Local Vault Cryptographic Subsystem" FontFamily="{StaticResource FluentDisplayFontFamily}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Commit new domain authorization operational secrets into targeted memory." FontFamily="{StaticResource FluentFontFamily}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <PasswordBox x:Name="TxtPassword" Margin="0,0,0,12"/>
                            <Button Content="Commit Secret To Vault" HorizontalAlignment="Left" Click="BtnCommitVault_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource FluentPanelCard}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="System Diagnostic Event Stream" FontFamily="{StaticResource FluentDisplayFontFamily}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4" BorderBrush="#3C3C3C" BorderThickness="1">
                            <ScrollViewer x:Name="TerminalScroll" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtTerminal" 
                                         Background="Transparent" 
                                         Foreground="#E0E0E0" 
                                         BorderThickness="0" 
                                         FontFamily="{StaticResource MonoFontFamily}" 
                                         FontSize="13" 
                                         IsReadOnly="True" 
                                         TextWrapping="Wrap" 
                                         Padding="12"
                                         SelectionBrush="{StaticResource SystemAccentBrush}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="1" Columns="2" Rows="1" Margin="0,16,0,0">
                    <Button Content="Interlock Override" Margin="0,0,8,0" Height="40" Click="BtnUnlockOverride_Click"/>
                    <Button Content="System Lockdown" Margin="8,0,0,0" Height="40" Style="{StaticResource AccentButton}" Background="{StaticResource StatusCriticalBrush}" Click="BtnLockdownOverride_Click"/>
                </UniformGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
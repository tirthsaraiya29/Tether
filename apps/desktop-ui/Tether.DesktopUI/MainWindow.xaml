<Window x:Class="Tether.DesktopUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TETHER // SECURE DESKTOP MANAGER" Height="700" Width="950" 
        Background="#060913" WindowStartupLocation="CenterScreen"
        BorderBrush="#00F0FF" BorderThickness="1.5" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="CyberCard" TargetType="Border">
            <Setter Property="Background" Value="#0D1527"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#1A294A"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <Border Style="{StaticResource CyberCard}" BorderBrush="#00F0FF">
                <StackPanel>
                    <TextBlock Text="TETHER CORE NETWORKING" FontSize="20" FontWeight="Black" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtUserType" Text="AUTHENTICATING SESSION DOMAIN..." FontSize="11" Foreground="#00F0FF" FontWeight="Bold" Margin="0,4,0,0"/>
                    <Separator Background="#1A294A" Margin="0,12,0,12"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="TxtStatus" Text="WAITING FOR SERVICE PIPELINE..." FontSize="14" FontWeight="Bold" Foreground="#8A99AD"/>
                            <TextBlock x:Name="TxtRssi" Text="RSSI NODE: -- dBm" FontSize="11" Foreground="#526685" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Ellipse x:Name="IndicatorNode" Width="16" Height="16" Fill="#FF0055" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF0055" BlurRadius="10" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CyberCard}">
                <StackPanel>
                    <TextBlock Text="HARDWARE NODE REGISTRY" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,16"/>

                    <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="SYSTEM MASTER VOLUME" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtVolumeValue" Text="0%" FontSize="11" Foreground="#00FF66" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </Grid>
                        <Slider x:Name="SliderVolume" ValueChanged="SliderVolume_ValueChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="HARDWARE MATRIX BRIGHTNESS" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtBrightnessValue" Text="0%" FontSize="11" Foreground="#00FF66" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </Grid>
                        <Slider x:Name="SliderBrightness" ValueChanged="SliderBrightness_ValueChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CyberCard}">
                <StackPanel>
                    <TextBlock Text="CRYPTOGRAPHIC VAULT CONFIGURATION" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtPassword" Height="34" Background="#060A12" Foreground="#FFFFFF" BorderBrush="#1A294A" VerticalContentAlignment="Center" Padding="8,0" Margin="0,8,0,12"/>
                    <Button Content="COMMIT CRYPTOGRAPHIC LSA VAULT" Height="38" Background="#00F0FF" Foreground="#060913" FontWeight="Bold" Click="BtnCommitVault_Click" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CyberCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="NATIVE SECURITY LOGS MATRIX" FontSize="12" FontWeight="Bold" Foreground="#FF0055" Margin="0,0,0,12"/>
                    <ScrollViewer x:Name="TerminalScroll" Grid.Row="1" Background="#050811" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtTerminal" Background="Transparent" Foreground="#00FF66" BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalAlignment="Stretch" Padding="10"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="2" Rows="1">
                <Button Content="MANUAL UNLOCK INTERLOCK" Height="42" Margin="0,0,6,0" Background="#0A2214" Foreground="#00FF66" BorderBrush="#00FF66" BorderThickness="1" FontWeight="Bold" Click="BtnUnlockOverride_Click"/>
                <Button Content="EXECUTE PANIC LOCKDOWN" Height="42" Margin="6,0,0,0" Background="#260914" Foreground="#FF0055" BorderBrush="#FF0055" BorderThickness="1" FontWeight="Bold" Click="BtnLockdownOverride_Click"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
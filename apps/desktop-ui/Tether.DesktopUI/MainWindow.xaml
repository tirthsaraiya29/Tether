<Window x:Class="Tether.DesktopUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tether — Security &amp; Telemetry Workstation"
        Height="820" Width="1160"
        MinHeight="720" MinWidth="1020"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="MainWindow_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource GlassSpecularBorderBrush}"
            BorderThickness="1">
        <Grid x:Name="LayoutRoot" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WindowScale" ScaleX="0.96" ScaleY="0.96"/>
                    <TranslateTransform x:Name="WindowTranslate" Y="20"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- LEFT FROSTED NAVIGATION RAIL                                  -->
            <!-- ============================================================= -->
            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Background="{StaticResource RailBackgroundBrush}"
                    BorderBrush="{StaticResource SubtleDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <Grid Grid.Row="0" Margin="22,8,16,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="32" Height="32"
                                CornerRadius="8"
                                Background="{StaticResource AccentPillBackgroundBrush}"
                                BorderBrush="{StaticResource AccentPillBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="15"
                                       Foreground="{StaticResource SystemAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TETHER"
                                       FontFamily="{StaticResource FluentDisplayFontFamily}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="CORE NODE v2.4"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Style="{StaticResource BadgePillBorderStyle}"
                                Padding="6,2">
                            <TextBlock Text="IPC"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextAccentBrush}"/>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="WORKSPACE NODES"
                               Style="{StaticResource SectionEyebrowTextStyle}"
                               Margin="24,12,0,6"/>

                    <!-- Streamlined Navigation Rail (Proximity Pairing Pruned) -->
                    <ListBox Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource NavigationItemStyle}">
                        <ListBoxItem IsSelected="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEEA3;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="15"
                                           Width="22"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Telemetry Overview"
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE95A;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="15"
                                           Width="22"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Hardware Controls"
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="15"
                                           Width="22"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="DPAPI Vault"
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Security Principal Status -->
                    <Border Grid.Row="3"
                            Margin="12,0,12,12"
                            Padding="14,12"
                            CornerRadius="10"
                            Background="{StaticResource GlassSurfaceSubtleBrush}"
                            BorderBrush="{StaticResource GlassSpecularBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="28" Height="28"
                                    CornerRadius="14"
                                    Background="#18FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SECURITY PRINCIPAL"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtUserType"
                                           Text="DOMAIN UNRESOLVED"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- INTEGRATED CAPTION BAR                                        -->
            <!-- ============================================================= -->
            <Grid Grid.Row="0"
                  Grid.Column="1"
                  Background="{StaticResource TitleBarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="28,4,0,0"
                            IsHitTestVisible="False">
                    <TextBlock Text="WORKSTATION"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  /  "
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="TELEMETRY CONTROL PLANE"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="BtnMinimize"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="10"
                            Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnMaximize"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#xE922;"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="10"
                            Click="BtnMaximize_Click"/>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource CloseTitleBarButton}"
                            Content="&#xE8BB;"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="10"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============================================================= -->
            <!-- MAIN WORKSPACE                                                -->
            <!-- ============================================================= -->
            <Grid Grid.Row="1"
                  Grid.Column="1"
                  Margin="28,12,28,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="0.92*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <StackPanel>

                        <!-- SECURITY PIPELINE -->
                        <Border Style="{StaticResource GlassPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SIGNAL ENFORCEMENT // NAMED PIPE BUS"
                                                   Style="{StaticResource SectionEyebrowTextStyle}"/>
                                        <TextBlock Text="Core Security Network Pipeline"
                                                   Style="{StaticResource CardTitleTextStyle}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="#14FFFFFF"
                                            BorderBrush="{StaticResource GlassSpecularBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="10,5"
                                            VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="IndicatorNode"
                                                     Width="10"
                                                     Height="10"
                                                     Fill="{StaticResource StatusCriticalBrush}"
                                                     Effect="{StaticResource StatusNodeGlow}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="NODE LINK"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="0,16,0,0"
                                        Padding="14,12"
                                        CornerRadius="8"
                                        Background="#12000000"
                                        BorderBrush="{StaticResource SubtleDividerBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="STATE VECTOR"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtStatus"
                                                       Text="WAITING FOR SERVICE PIPELINE..."
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Style="{StaticResource BadgePillBorderStyle}">
                                            <TextBlock x:Name="TxtRssi"
                                                       Text="RSSI NODE: -- dBm"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextAccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- HARDWARE INTEGRATIONS -->
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <TextBlock Text="COREAUDIO COM &amp; DXVA2 / WMI BACKENDS"
                                           Style="{StaticResource SectionEyebrowTextStyle}"/>
                                <TextBlock Text="Hardware Device Layer Integrations"
                                           Style="{StaticResource CardTitleTextStyle}"
                                           Margin="0,0,0,18"/>

                                <!-- Master Volume Slider -->
                                <Border Padding="14,12"
                                        CornerRadius="8"
                                        Background="#0D000000"
                                        BorderBrush="{StaticResource SubtleDividerBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE767;"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="14"
                                                           Foreground="{StaticResource SystemAccentBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="System Master Volume"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Border Style="{StaticResource BadgePillBorderStyle}"
                                                    HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtVolumeValue"
                                                           Text="0%"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider x:Name="SliderVolume"
                                                Minimum="0"
                                                Maximum="100"
                                                ValueChanged="SliderVolume_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Display Brightness Slider -->
                                <Border Padding="14,12"
                                        CornerRadius="8"
                                        Background="#0D000000"
                                        BorderBrush="{StaticResource SubtleDividerBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE706;"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="14"
                                                           Foreground="{StaticResource SystemAccentBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="Display Matrix Luminescence"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Border Style="{StaticResource BadgePillBorderStyle}"
                                                    HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtBrightnessValue"
                                                           Text="0%"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider x:Name="SliderBrightness"
                                                Minimum="0"
                                                Maximum="100"
                                                ValueChanged="SliderBrightness_ValueChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- DPAPI VAULT -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="CRYPT32 // DPAPI ENTROPY SEAL"
                                                   Style="{StaticResource SectionEyebrowTextStyle}"/>
                                        <TextBlock Text="Local Vault Cryptographic Subsystem"
                                                   Style="{StaticResource CardTitleTextStyle}"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource BadgePillBorderStyle}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="LOCALMACHINE"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Validate domain credentials via LogonUser and seal secret payload into HKLM CredentialProvider registry storage."
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap"/>

                                <PasswordBox x:Name="TxtPassword"
                                             Margin="0,0,0,14"/>

                                <Button x:Name="BtnCommitVault"
                                        Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Stretch"
                                        Click="BtnCommitVault_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D7;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Commit Secret To Vault"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT COLUMN -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TERMINAL -->
                    <Border Grid.Row="0"
                            Style="{StaticResource GlassPanel}"
                            Padding="20"
                            Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="REALTIME IPC BUS MONITOR"
                                               Style="{StaticResource SectionEyebrowTextStyle}"/>
                                    <TextBlock Text="System Diagnostic Event Stream"
                                               Style="{StaticResource CardTitleTextStyle}"/>
                                </StackPanel>

                                <Border Background="#14FFFFFF"
                                        BorderBrush="{StaticResource SubtleDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{StaticResource StatusHealthyBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="STDOUT // UTF-8"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="{StaticResource TerminalBackgroundBrush}"
                                    BorderBrush="{StaticResource TerminalBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="TerminalScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="4">
                                    <TextBox x:Name="TxtTerminal"
                                             Background="Transparent"
                                             Foreground="#E2E8F0"
                                             BorderThickness="0"
                                             FontFamily="{StaticResource MonoFontFamily}"
                                             FontSize="12"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Padding="12,10"
                                             CaretBrush="{StaticResource SystemAccentBrush}"
                                             SelectionBrush="{StaticResource SystemAccentBrush}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- INTERLOCK ACTIONS -->
                    <UniformGrid Grid.Row="1"
                                 Columns="2"
                                 Rows="1"
                                 Margin="0,16,0,0">
                        <Button x:Name="BtnUnlockOverride"
                                Margin="0,0,6,0"
                                Height="42"
                                Click="BtnUnlockOverride_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE785;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="13"
                                           Foreground="{StaticResource StatusHealthyBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Interlock Override"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnLockdownOverride"
                                Margin="6,0,0,0"
                                Height="42"
                                Style="{StaticResource DestructiveButton}"
                                Click="BtnLockdownOverride_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="System Lockdown"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
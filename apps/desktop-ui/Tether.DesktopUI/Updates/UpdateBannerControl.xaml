<UserControl x:Class="Tether.DesktopUI.Updates.UpdateBannerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="800"
             Visibility="Collapsed">

    <Border Margin="18,10,18,6"
            CornerRadius="10"
            Background="#1C0E1422"
            BorderBrush="#4438BDF8"
            BorderThickness="1"
            Padding="16,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="8"
                        Background="#2238BDF8"
                        BorderBrush="#6638BDF8"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE777;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="16"
                               Foreground="#38BDF8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#22F43F5E"
                                BorderBrush="#66F43F5E"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                Margin="0,0,8,0">
                            <TextBlock Text="SECURITY &amp; SYSTEM UPDATE"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#F43F5E"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="TxtVersionBadge"
                                   Text="v1.1.7"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtDescription"
                               Text="A new critical update is ready to install. Smart update detected changed files."
                               FontFamily="{StaticResource FluentFontFamily}"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleNotes"
                            Style="{DynamicResource SubtleIconButton}"
                            Height="32"
                            Padding="8,0"
                            Margin="0,0,8,0"
                            Click="BtnToggleNotes_Click"
                            ToolTip="View release notes">
                        <TextBlock x:Name="TxtNotesChevron"
                                   Text="&#xE70D;"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>

                    <ComboBox x:Name="CmbRemindMe"
                              Height="32"
                              Width="140"
                              Margin="0,0,8,0"
                              SelectedIndex="0"
                              SelectionChanged="CmbRemindMe_SelectionChanged">
                        <ComboBoxItem Content="Remind in 1h" Tag="1"/>
                        <ComboBoxItem Content="Remind in 4h" Tag="4"/>
                        <ComboBoxItem Content="Remind in 24h" Tag="24"/>
                    </ComboBox>

                    <Button x:Name="BtnUpdateNow"
                            Style="{StaticResource AccentButton}"
                            Height="32"
                            Padding="14,0"
                            Click="BtnUpdateNow_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="11"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtUpdateBtnLabel"
                                       Text="Update Now"
                                       FontFamily="{StaticResource FluentFontFamily}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="NotesBorder"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{StaticResource RecessedWellBrush}"
                    BorderBrush="{StaticResource SubtleDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,10,0,0"
                    Padding="12,10">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtReleaseNotes"
                               Text=""
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
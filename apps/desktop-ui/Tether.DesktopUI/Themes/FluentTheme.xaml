<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===================================================================== -->
    <!-- TYPOGRAPHY RESOURCES                                                  -->
    <!-- ===================================================================== -->
    <FontFamily x:Key="FluentDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Code, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===================================================================== -->
    <!-- CORE OBSIDIAN & FROSTED GLASS PALETTE                                 -->
    <!-- ===================================================================== -->
    <Color x:Key="ObsidianBaseColor">#D8080B11</Color>
    <Color x:Key="ObsidianSurfaceColor">#B80C1018</Color>
    <Color x:Key="ObsidianRailColor">#94070A0F</Color>
    <Color x:Key="GlassLayerPrimaryColor">#12FFFFFF</Color>
    <Color x:Key="GlassLayerSecondaryColor">#08FFFFFF</Color>
    <Color x:Key="GlassLayerHoverColor">#1BFFFFFF</Color>
    <Color x:Key="GlassLayerActiveColor">#0DFFFFFF</Color>
    <Color x:Key="TerminalSurfaceColor">#B505070B</Color>

    <!-- Primary Accent Palette (Electric Cyan / Azure) -->
    <Color x:Key="AccentPrimaryColor">#38BDF8</Color>
    <Color x:Key="AccentSecondaryColor">#0284C7</Color>
    <Color x:Key="AccentGlowColor">#6038BDF8</Color>

    <!-- Semantic Telemetry Colors -->
    <Color x:Key="StatusHealthyColor">#34D399</Color>
    <Color x:Key="StatusDegradedColor">#FBBF24</Color>
    <Color x:Key="StatusCriticalColor">#FB7185</Color>
    <Color x:Key="StatusCriticalDarkColor">#E11D48</Color>

    <!-- ===================================================================== -->
    <!-- SURFACE & BACKDROP BRUSHES                                            -->
    <!-- ===================================================================== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource ObsidianBaseColor}"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="{StaticResource ObsidianRailColor}"/>
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="{StaticResource TerminalSurfaceColor}"/>

    <!-- Layered Glass Card Fill (Top-Left Luminance Falloff) -->
    <LinearGradientBrush x:Key="GlassPanelBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.45"/>
        <GradientStop Color="#06FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassPanelHoverBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1CFFFFFF" Offset="0.0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.5"/>
        <GradientStop Color="#09FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassSurfaceSubtleBrush" Color="{StaticResource GlassLayerSecondaryColor}"/>
    <SolidColorBrush x:Key="GlassControlFillBrush" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="GlassControlHoverBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="GlassControlPressedBrush" Color="#09FFFFFF"/>

    <!-- ===================================================================== -->
    <!-- SPECULAR BORDER & DIVIDER BRUSHES                                     -->
    <!-- ===================================================================== -->
    <!-- 1px Specular Highlight Edge: simulates overhead light catching glass -->
    <LinearGradientBrush x:Key="GlassSpecularBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2CFFFFFF" Offset="0.0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.35"/>
        <GradientStop Color="#07FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassControlBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0EFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="TerminalBorderBrush" Color="#18FFFFFF"/>

    <!-- ===================================================================== -->
    <!-- ACCENT & SEMANTIC STATUS BRUSHES                                      -->
    <!-- ===================================================================== -->
    <!-- Code-behind lookup keys preserved: StatusHealthyBrush / StatusCriticalBrush -->
    <SolidColorBrush x:Key="SystemAccentBrush" Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="StatusHealthyBrush" Color="{StaticResource StatusHealthyColor}"/>
    <SolidColorBrush x:Key="StatusDegradedBrush" Color="{StaticResource StatusDegradedColor}"/>
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="{StaticResource StatusCriticalColor}"/>

    <!-- Soft Pill Background Brushes -->
    <SolidColorBrush x:Key="AccentPillBackgroundBrush" Color="#1A38BDF8"/>
    <SolidColorBrush x:Key="AccentPillBorderBrush" Color="#4038BDF8"/>
    <SolidColorBrush x:Key="HealthyPillBackgroundBrush" Color="#1834D399"/>
    <SolidColorBrush x:Key="CriticalPillBackgroundBrush" Color="#1DFB7185"/>
    <SolidColorBrush x:Key="CriticalPillBorderBrush" Color="#45FB7185"/>

    <!-- Interactive Gradients -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0.0"/>
        <GradientStop Color="#0EA5E9" Offset="0.55"/>
        <GradientStop Color="#0284C7" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7DD3FC" Offset="0.0"/>
        <GradientStop Color="#38BDF8" Offset="0.55"/>
        <GradientStop Color="#0EA5E9" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DestructiveGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB7185" Offset="0.0"/>
        <GradientStop Color="#F43F5E" Offset="0.5"/>
        <GradientStop Color="#E11D48" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DestructiveHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FDA4AF" Offset="0.0"/>
        <GradientStop Color="#FB7185" Offset="0.5"/>
        <GradientStop Color="#F43F5E" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ===================================================================== -->
    <!-- TYPOGRAPHY FOREGROUND BRUSHES                                         -->
    <!-- ===================================================================== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F6FC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextAccentBrush" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#04080E"/>

    <!-- ===================================================================== -->
    <!-- AMBIENT GLOW & ELEVATION EFFECTS                                      -->
    <!-- ===================================================================== -->
    <DropShadowEffect x:Key="CardElevationShadow"
                      BlurRadius="24"
                      ShadowDepth="6"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.38"/>

    <DropShadowEffect x:Key="AccentAmbientGlow"
                      BlurRadius="16"
                      ShadowDepth="0"
                      Color="{StaticResource AccentPrimaryColor}"
                      Opacity="0.45"/>

    <DropShadowEffect x:Key="StatusNodeGlow"
                      BlurRadius="14"
                      ShadowDepth="0"
                      Color="#FFFFFF"
                      Opacity="0.35"/>

</ResourceDictionary>
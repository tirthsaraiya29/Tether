<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ===================================================================== -->
    <!-- TYPOGRAPHY RESOURCES                                                  -->
    <!-- ===================================================================== -->
    <FontFamily x:Key="FluentDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Code, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===================================================================== -->
    <!-- INDUSTRIAL CARBON & PRECISION DARK PALETTE                            -->
    <!-- ===================================================================== -->
    <Color x:Key="ObsidianBaseColor">#EA06080D</Color>
    <Color x:Key="ObsidianRailColor">#F2080B11</Color>
    <Color x:Key="ObsidianHeaderColor">#F2090D14</Color>
    <Color x:Key="CardSurfacePrimaryColor">#E60D121B</Color>
    <Color x:Key="CardSurfaceHoverColor">#EC101722</Color>
    <Color x:Key="RecessedWellColor">#D905070B</Color>
    <Color x:Key="TerminalSurfaceColor">#F5040609</Color>

    <!-- Crisp Accent Palette -->
    <Color x:Key="AccentPrimaryColor">#38BDF8</Color>
    <Color x:Key="AccentSecondaryColor">#0284C7</Color>

    <!-- Semantic Telemetry Colors -->
    <Color x:Key="StatusHealthyColor">#10B981</Color>
    <Color x:Key="StatusDegradedColor">#F59E0B</Color>
    <Color x:Key="StatusCriticalColor">#F43F5E</Color>

    <!-- ===================================================================== -->
    <!-- FROZEN SURFACE & BACKDROP BRUSHES (ZERO-ALLOCATION)                   -->
    <!-- ===================================================================== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource ObsidianBaseColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource ObsidianHeaderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="{StaticResource ObsidianRailColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="{StaticResource TerminalSurfaceColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="RecessedWellBrush" Color="{StaticResource RecessedWellColor}" po:Freeze="True"/>

    <SolidColorBrush x:Key="GlassPanelBackgroundBrush" Color="{StaticResource CardSurfacePrimaryColor}" po:Freeze="True"/>

    <SolidColorBrush x:Key="GlassSurfaceSubtleBrush" Color="#0CFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassControlFillBrush" Color="#12FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassControlHoverBrush" Color="#1EFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassControlPressedBrush" Color="#0AFFFFFF" po:Freeze="True"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#D806080D" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="#E6080B12" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputFocusedBackgroundBrush" Color="#F504060A" po:Freeze="True"/>

    <!-- ===================================================================== -->
    <!-- 1PX HAIRLINE & SPECULAR BORDER BRUSHES                                -->
    <!-- ===================================================================== -->
    <SolidColorBrush x:Key="GlassSpecularBorderBrush" Color="#1FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassControlBorderBrush" Color="#26FFFFFF" po:Freeze="True"/>

    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#15FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TerminalBorderBrush" Color="#1EFFFFFF" po:Freeze="True"/>

    <!-- ===================================================================== -->
    <!-- ACCENT & SEMANTIC STATUS BRUSHES                                      -->
    <!-- ===================================================================== -->
    <SolidColorBrush x:Key="SystemAccentBrush" Color="{StaticResource AccentPrimaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatusHealthyBrush" Color="{StaticResource StatusHealthyColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatusDegradedBrush" Color="{StaticResource StatusDegradedColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="{StaticResource StatusCriticalColor}" po:Freeze="True"/>

    <!-- Status halo brushes retained as solid fills (code-behind sets them by key) -->
    <SolidColorBrush x:Key="HealthyHaloBrush" Color="#6610B981" po:Freeze="True"/>
    <SolidColorBrush x:Key="CriticalHaloBrush" Color="#66F43F5E" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHaloBrush" Color="#6638BDF8" po:Freeze="True"/>

    <!-- Semantic Pill Brushes -->
    <SolidColorBrush x:Key="AccentPillBackgroundBrush" Color="#1838BDF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentPillBorderBrush" Color="#4038BDF8" po:Freeze="True"/>

    <SolidColorBrush x:Key="HealthyPillBackgroundBrush" Color="#1610B981" po:Freeze="True"/>
    <SolidColorBrush x:Key="HealthyPillBorderBrush" Color="#4010B981" po:Freeze="True"/>

    <SolidColorBrush x:Key="CriticalPillBackgroundBrush" Color="#1AF43F5E" po:Freeze="True"/>
    <SolidColorBrush x:Key="CriticalPillBorderBrush" Color="#48F43F5E" po:Freeze="True"/>

    <SolidColorBrush x:Key="NeutralPillBackgroundBrush" Color="#10FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="NeutralPillBorderBrush" Color="#1FFFFFFF" po:Freeze="True"/>

    <!-- Accent fills -->
    <SolidColorBrush x:Key="AccentGradientBrush" Color="{StaticResource AccentPrimaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverGradientBrush" Color="#5BBDE9FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="DestructiveGradientBrush" Color="{StaticResource StatusCriticalColor}" po:Freeze="True"/>

    <!-- ===================================================================== -->
    <!-- TYPOGRAPHY FOREGROUND BRUSHES                                         -->
    <!-- ===================================================================== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextAccentBrush" Color="#7DD3FC" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#030712" po:Freeze="True"/>

</ResourceDictionary>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="ControlInputBackgroundBrush" Color="#2D2D2D"/>

    <SolidColorBrush x:Key="SystemAccentBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="SystemAccentHoverBrush" Color="#76D4FF"/>
    <SolidColorBrush x:Key="SystemAccentPressedBrush" Color="#4BA3CC"/>

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#FFFFFF" Opacity="0.06"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#FFFFFF" Opacity="0.10"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5F5F5F"/>

    <SolidColorBrush x:Key="StatusHealthyBrush" Color="#6AED7E"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFE770"/>
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="#FF99A4"/>
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="StatusProcessingBrush" Color="#60CDFF"/>

    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="FluentDisplayFontFamily">Segoe UI Variable Display, Segoe UI Semibold, Arial</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Courier New</FontFamily>

    <DropShadowEffect x:Key="CardDropShadow" BlurRadius="16" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.25"/>
    <DropShadowEffect x:Key="ControlGlowEffect" BlurRadius="8" ShadowDepth="0" Color="#60CDFF" Opacity="0.4"/>
</ResourceDictionary>
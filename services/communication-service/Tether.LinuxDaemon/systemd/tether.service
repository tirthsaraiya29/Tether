[Unit]
Description=Tether Linux Daemon
Documentation=https://github.com/tirthsaraiya29/tether
After=network.target network-online.target dbus.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tether-daemon
Restart=on-failure
RestartSec=3s
KillMode=control-group
StandardOutput=journal
StandardError=journal
SupplementaryGroups=tether

# Security Sandboxing & Least Privilege Constraints
ProtectSystem=full
ProtectHome=no
ReadWritePaths=/var/lib/tether /run/tether /var/log/tether /home
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input rw
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

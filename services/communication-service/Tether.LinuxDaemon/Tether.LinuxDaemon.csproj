<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tether.LinuxDaemon</AssemblyName>
    <RootNamespace>Tether.LinuxDaemon</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\Tether.Shared\Tether.Shared.csproj" />
    <ProjectReference Include="..\..\event-bus\Tether.EventBus\Tether.EventBus.csproj" />
    <ProjectReference Include="..\..\trust-engine\Tether.TrustEngine\Tether.TrustEngine.csproj" />
    <ProjectReference Include="..\..\recovery-engine\Tether.RecoveryEngine\Tether.RecoveryEngine.csproj" />
    <ProjectReference Include="..\..\enforcement-engine\Tether.EnforcementEngine\Tether.EnforcementEngine.csproj" />
  </ItemGroup>

</Project>

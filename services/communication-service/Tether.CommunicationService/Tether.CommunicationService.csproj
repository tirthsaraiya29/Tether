<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>

		<TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
		<PackageReference Include="System.Threading.AccessControl" Version="10.0.8" />
		<PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
		<PackageReference Include="System.Management" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\shared\Tether.Shared\Tether.Shared.csproj" />
		<ProjectReference Include="..\..\event-bus\Tether.EventBus\Tether.EventBus.csproj" />
		<ProjectReference Include="..\..\trust-engine\Tether.TrustEngine\Tether.TrustEngine.csproj" />
		<ProjectReference Include="..\..\enforcement-engine\Tether.EnforcementEngine\Tether.EnforcementEngine.csproj" />
		<ProjectReference Include="..\..\panic-engine\Tether.PanicEngine\Tether.PanicEngine.csproj" />
		<ProjectReference Include="..\..\recovery-engine\Tether.RecoveryEngine\Tether.RecoveryEngine.csproj" />
	</ItemGroup>
	<Target Name="BuildAndCopySessionHelper" BeforeTargets="BeforeBuild">
		<MSBuild
		  Projects="..\Tether.SessionHelper\Tether.SessionHelper.csproj"
		  Targets="Publish"
		  Properties="Configuration=$(Configuration);Platform=AnyCPU" />

		<ItemGroup>
			<SessionHelperFiles Include="..\Tether.SessionHelper\bin\$(Configuration)\net8.0-windows\win-x64\publish\Tether.SessionHelper.exe" />
		</ItemGroup>

		<Copy
		  SourceFiles="@(SessionHelperFiles)"
		  DestinationFolder="$(OutDir)"
		  SkipUnchangedFiles="true" />
	</Target>
</Project>